  <UsingTask TaskName="SyncFilters" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Compiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Includes ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Nones ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Resources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="false" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public class SyncFilters : Task
{
    public ITaskItem[] Compiles { get; set; }
    public ITaskItem[] Includes { get; set; }
    public ITaskItem[] Nones { get; set; }
    public ITaskItem[] Resources { get; set; }
    public string OutputFile { get; set; }

    const char Sep = (char)92;
    static readonly string Wall = Sep.ToString();
    static readonly string Quote = ((char)34).ToString();
    static readonly string Nl = ((char)13).ToString() + ((char)10).ToString();

    static readonly string[][] Roots =
    {
        new[] { "depends" + Wall + "imgui", "Dependencies" + Wall + "ImGui" },
        new[] { "depends" + Wall + "minhook" + Wall + "src", "Dependencies" + Wall + "MinHook" },
        new[] { "depends" + Wall + "minhook", "Dependencies" + Wall + "MinHook" },
        new[] { "depends" + Wall + "minimp3", "Dependencies" + Wall + "minimp3" },
        new[] { "depends" + Wall + "vorbis" + Wall + "ogg", "Dependencies" + Wall + "Vorbis" },
        new[] { "depends" + Wall + "vorbis" + Wall + "vorbis", "Dependencies" + Wall + "Vorbis" },
        new[] { "depends" + Wall + "vorbis", "Dependencies" + Wall + "Vorbis" },
        new[] { "resource", "Resources" },
        new[] { "src", "" },
    };

    static string FilterOf(string spec)
    {
        var dir = Path.GetDirectoryName(spec ?? string.Empty) ?? string.Empty;
        dir = dir.Replace((char)47, Sep).Trim(Sep);

        foreach (var pair in Roots)
        {
            if (string.Equals(dir, pair[0], StringComparison.OrdinalIgnoreCase))
                return pair[1];

            var prefix = pair[0] + Wall;

            if (dir.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                var rest = dir.Substring(prefix.Length);
                return pair[1].Length == 0 ? rest : pair[1] + Wall + rest;
            }
        }

        return dir;
    }

    static ulong Fnv(string text, ulong seed)
    {
        var hash = seed;

        foreach (var c in text)
        {
            hash ^= c;
            hash *= 1099511628211UL;
        }

        return hash;
    }

    static string Identifier(string name)
    {
        var key = name.ToLowerInvariant();
        var hex = Fnv(key, 14695981039346656037UL).ToString("x16") +
                  Fnv(key + Wall, 1469598103934665603UL).ToString("x16");

        return "{" + hex.Substring(0, 8) + "-" + hex.Substring(8, 4) + "-" + hex.Substring(12, 4) +
               "-" + hex.Substring(16, 4) + "-" + hex.Substring(20, 12) + "}";
    }

    static void Group(StringBuilder text, string element, ITaskItem[] items, SortedSet<string> folders)
    {
        if (items == null || items.Length == 0)
            return;

        text.Append("  <ItemGroup>" + Nl);

        foreach (var item in items)
        {
            var filter = FilterOf(item.ItemSpec);
            var open = "    <" + element + " Include=" + Quote + item.ItemSpec + Quote;

            if (filter.Length == 0)
            {
                text.Append(open + " />" + Nl);
                continue;
            }

            for (var at = filter.IndexOf(Sep); at >= 0; at = filter.IndexOf(Sep, at + 1))
                folders.Add(filter.Substring(0, at));

            folders.Add(filter);

            text.Append(open + ">" + Nl);
            text.Append("      <Filter>" + filter + "</Filter>" + Nl);
            text.Append("    </" + element + ">" + Nl);
        }

        text.Append("  </ItemGroup>" + Nl);
    }

    public override bool Execute()
    {
        var folders = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);
        var body = new StringBuilder();

        Group(body, "ClCompile", Compiles, folders);
        Group(body, "ClInclude", Includes, folders);
        Group(body, "None", Nones, folders);
        Group(body, "ResourceCompile", Resources, folders);

        var text = new StringBuilder();
        text.Append("<?xml version=" + Quote + "1.0" + Quote + " encoding=" + Quote + "utf-8" + Quote + "?>" + Nl);
        text.Append("<Project ToolsVersion=" + Quote + "4.0" + Quote + " xmlns=" + Quote +
                    "http://schemas.microsoft.com/developer/msbuild/2003" + Quote + ">" + Nl);
        text.Append("  <ItemGroup>" + Nl);

        foreach (var folder in folders)
        {
            text.Append("    <Filter Include=" + Quote + folder + Quote + ">" + Nl);
            text.Append("      <UniqueIdentifier>" + Identifier(folder) + "</UniqueIdentifier>" + Nl);
            text.Append("    </Filter>" + Nl);
        }

        text.Append("  </ItemGroup>" + Nl);
        text.Append(body.ToString());
        text.Append("</Project>");

        var wanted = text.ToString();

        if (File.Exists(OutputFile) && File.ReadAllText(OutputFile) == wanted)
            return true;

        File.WriteAllText(OutputFile, wanted, new UTF8Encoding(true));
        Log.LogMessage(MessageImportance.High,
            "Solution Explorer folders rebuilt: " + folders.Count + " filter(s)");

        return true;
    }
}
]]></Code>
    </Task>
  </UsingTask>

