<rml>
<head>
	<title>Great Lobby - histórico</title>
	<link type="text/rcss" href="lobby.rcss"/>
</head>
<body class="modal" data-model="gl" data-class-ps="glyphs == 'ps'" data-class-flat="glyphs == 'flat'">
	<div class="dialog" id="history">
		<div class="title">Histórico da noite</div>
		<div class="txt">Todas as séries que terminaram neste lobby desde que você entrou.</div>
		<div class="hist-list">
			<div class="hist-row" data-for="h : history" data-class-mine="h.mine">
				<span class="hist-time">{{h.time}}</span>
				<span class="hist-table">Mesa {{h.table}}</span>
				<span class="hist-name">{{h.a}}</span>
				<span class="hist-score">{{h.sa}} – {{h.sb}}</span>
				<span class="hist-name r">{{h.b}}</span>
				<span class="hist-note" data-if="h.note != ''">{{h.note}}</span>
			</div>
			<div class="emptylist" data-if="history.size == 0">Nenhuma série terminou ainda.</div>
		</div>
		<div class="actions">
			<div class="btn" autofocus="" data-event-click="close_history()">Fechar<span class="key k-b">{{g_b}}</span></div>
		</div>
	</div>
</body>
</rml>
