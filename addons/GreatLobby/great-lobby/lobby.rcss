/* Great Lobby — reference layout is 1920x1080 in dp; dp scales with the game's height. */

body, div, p, h1, h2, header, section, footer, nav, aside { display: block; }
span { display: inline; }
img { display: inline-block; }

body {
	width: 100%;
	height: 100%;
	font-family: Barlow;
	font-weight: 400;
	font-size: 15dp;
	color: #ecebf0;
	background-color: #0a0a0c;
	decorator: image(bg.png cover);
}

.cond { font-family: Barlow Condensed; }

#app {
	display: flex;
	flex-direction: column;
	height: 100%;
	padding: 18dp 26dp 14dp 26dp;
	box-sizing: border-box;
}

/* ---------- top bar ---------- */
#top { display: flex; align-items: center; height: 84dp; flex: 0 0 84dp; }
.logo { display: flex; align-items: center; }
.logo .mark {
	width: 46dp; height: 46dp; line-height: 46dp; text-align: center;
	font-family: Barlow Condensed; font-weight: 800; font-size: 24dp;
	decorator: horizontal-gradient(#7e3bd6 #c0263f);
	
	margin-right: 12dp;
}
.logo .t1 { font-family: Barlow Condensed; font-weight: 800; font-size: 30dp; letter-spacing: 1.8dp; line-height: 30dp; }
.logo .t2 { font-family: Barlow Condensed; font-weight: 600; font-size: 13dp; letter-spacing: 4dp; color: #b08cf0; }
.sep { width: 1px; height: 48dp; background-color: #3a3742; margin: 0 22dp; }
.room .title { font-family: Barlow Condensed; font-weight: 700; font-size: 30dp; line-height: 32dp; }
.room .meta { display: flex; margin-top: 7dp; }
.chip {
	font-family: Barlow Condensed; font-weight: 600; font-size: 13dp; letter-spacing: 0.8dp;
	text-transform: uppercase; color: #9a97a3;
	padding: 3dp 10dp; margin-right: 8dp;
	border: 1px #3a3742; background-color: rgba(255,255,255,8);
	
}
.chip .v { color: #ecebf0; }
.chip.casual { border-color: rgba(74,222,128,102); color: #4ade80; }

.host {
	display: flex; align-items: center; margin-left: 22dp; padding: 8dp 14dp;
	border-left: 3dp #e0415a;
	decorator: horizontal-gradient(rgba(251,191,36,28) rgba(251,191,36,0));
}
.host .crown { color: #e0415a; font-size: 20dp; margin-right: 10dp; }
.host .lbl { font-family: Barlow Condensed; font-weight: 600; font-size: 11dp; letter-spacing: 2.4dp; color: #9a97a3; }
.host .who { font-family: Barlow Condensed; font-weight: 700; font-size: 20dp; line-height: 22dp; }
.grow { flex: 1 1 0; }

.btn {
	display: inline-block;
	font-family: Barlow Condensed; font-weight: 700; font-size: 15dp; letter-spacing: 1.2dp; text-transform: uppercase;
	padding: 9dp 18dp; margin-left: 10dp;
	border: 1px #3a3742; background-color: rgba(255,255,255,10); color: #ecebf0;
	
	tab-index: auto; nav: auto; focus: auto;
	transition: background-color border-color 0.12s linear-in-out;
}
.btn:hover { background-color: rgba(255,255,255,26); }
.btn:focus { border-color: #b08cf0; background-color: rgba(126,59,214,60); }
.btn.pri { decorator: horizontal-gradient(#7e3bd6 #6d28d9); border-color: #7e3bd6; }
.btn.red { decorator: horizontal-gradient(#c0263f #be123c); border-color: #c0263f; }
.btn.gold { border-color: rgba(224,65,90,102); color: #e0415a; }
.btn.small { padding: 6dp 14dp; font-size: 13dp; margin-left: 0; }
.key {
	display: inline-block; min-width: 22dp; height: 22dp; line-height: 22dp; padding: 0 5dp; margin-left: 6dp;
	border-radius: 11dp; background-color: rgba(255,255,255,31); text-align: center;
	font-family: Barlow; font-weight: 600; font-size: 12dp; color: #ecebf0;
	box-sizing: border-box;
}

.cap { text-align: right; margin-left: 18dp; }
.cap .n { font-family: Barlow Condensed; font-weight: 800; font-size: 38dp; line-height: 38dp; }
.cap .n .of { color: #6b6874; font-size: 24dp; }
.cap .lbl { font-family: Barlow Condensed; font-weight: 600; font-size: 12dp; letter-spacing: 2.4dp; color: #9a97a3; }
.capbar { width: 150dp; height: 5dp; background-color: #2a2830; margin-top: 5dp; }
.capbar .fill { height: 5dp; width: 78%; decorator: horizontal-gradient(#7e3bd6 #c0263f); }

/* ---------- main ---------- */
#main { display: flex; flex: 1 1 0; margin-top: 14dp; margin-bottom: 14dp; }
#left { display: flex; flex-direction: column; flex: 1 1 0; margin-right: 18dp; }
#right { display: flex; flex-direction: column; flex: 0 0 560dp; }

.sectitle { display: flex; align-items: center; height: 30dp; }
.sectitle .bar { width: 6dp; height: 18dp; background-color: #c0263f; margin-right: 10dp; }
.sectitle .h { font-family: Barlow Condensed; font-weight: 800; font-size: 22dp; letter-spacing: 2.2dp; text-transform: uppercase; }
.sectitle .h.small { font-size: 19dp; }
.sectitle .sub { font-family: Barlow Condensed; font-weight: 600; font-size: 14dp; letter-spacing: 1dp; color: #9a97a3; margin-left: 12dp; }
.tabs { display: flex; }
.tab {
	font-family: Barlow Condensed; font-weight: 700; font-size: 13dp; letter-spacing: 1.3dp; text-transform: uppercase;
	padding: 4dp 12dp; color: #9a97a3; border-bottom: 2px rgba(0,0,0,0);
	tab-index: auto; nav: auto;
}
.tab.on { color: #ecebf0; border-bottom-color: #7e3bd6; }
.tab:hover, .tab:focus { color: #ecebf0; }

/* tables */
#tables { display: flex; flex-wrap: wrap; justify-content: space-between; align-content: space-between; height: 698dp; margin-top: 12dp; }
.card {
	display: flex; flex-direction: column;
	width: 32.6%; height: 342dp; box-sizing: border-box;
	padding: 14dp 16dp;
	border: 1px #2a2830;
	decorator: vertical-gradient(rgba(26,24,30,242) rgba(13,16,36,240));
	tab-index: auto; nav: auto; focus: auto;
}
.card:focus { border-color: #b08cf0; }
.card.watching { border: 2px #7e3bd6; padding: 13dp 15dp; }
.card .hd { display: flex; align-items: center; font-family: Barlow Condensed; font-weight: 700; font-size: 14dp; letter-spacing: 1.7dp; text-transform: uppercase; color: #9a97a3; }
.card .hd .tag { margin-left: auto; }
.pill { font-family: Barlow Condensed; font-weight: 700; font-size: 12dp; letter-spacing: 1.4dp; text-transform: uppercase; padding: 2dp 8dp; margin-left: 8dp; }
.pill.live { background-color: #c0263f; color: #ffffff; }
.pill.sel { background-color: rgba(96,165,250,38); color: #60a5fa; border: 1px rgba(96,165,250,85); }
.pill.rem { background-color: rgba(251,191,36,32); color: #e0415a; border: 1px rgba(251,191,36,85); }
.pill.free { background-color: rgba(74,222,128,24); color: #4ade80; border: 1px rgba(74,222,128,85); }

.vs { display: flex; align-items: center; flex: 1 1 0; }
.pl { display: flex; flex-direction: column; flex: 1 1 0; }
.pl.r { align-items: flex-end; text-align: right; }
.face { width: 86dp; height: 86dp; border: 2px #3a3742; background-color: #0e0e11; }
.pl .name { font-family: Barlow Condensed; font-weight: 700; font-size: 22dp; margin-top: 8dp; }
.pl .char { font-family: Barlow Condensed; font-weight: 600; font-size: 13dp; letter-spacing: 1.3dp; text-transform: uppercase; color: #9a97a3; }
.rounds { display: flex; margin-top: 6dp; }
.round { width: 14dp; height: 6dp; margin-right: 4dp; background-color: #3a3742; }
.round.won { background-color: #e0415a; }
.mid { flex: 0 0 130dp; text-align: center; }
.score { font-family: Barlow Condensed; font-weight: 800; font-size: 44dp; }
.score .dash { color: #6b6874; }
.mid .detail { font-family: Barlow Condensed; font-weight: 600; font-size: 12dp; letter-spacing: 1.2dp; color: #9a97a3; }
.foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10dp; padding-top: 10dp; border-top: 1px #2a2830; }
.eye { font-family: Barlow Condensed; font-weight: 600; font-size: 14dp; letter-spacing: 0.6dp; color: #9a97a3; }
.eye .v { color: #ecebf0; }
.ping { color: #4ade80; }
.empty { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1 1 0; margin-top: 8dp; border: 1px #3a3742; text-align: center; color: #9a97a3; }
.empty .who { font-family: Barlow Condensed; font-weight: 700; font-size: 24dp; color: #ecebf0; }
.empty .btn { margin: 14dp 0 0 0; }

/* queue */
#queue { margin-top: 12dp; height: 100dp; padding: 12dp 16dp; border: 1px #2a2830; background-color: rgba(20,19,23,214); box-sizing: border-box; }
.qrow { display: flex; margin-top: 8dp; }
.match { display: flex; align-items: center; padding: 6dp 12dp; margin-right: 10dp; border: 1px #2a2830; background-color: rgba(255,255,255,7); }
.match.mine { border-color: #7e3bd6; background-color: rgba(126,59,214,26); }
.match.next { border-color: rgba(224,65,90,102); }
.match .no { font-family: Barlow Condensed; font-weight: 800; font-size: 20dp; color: #6b6874; width: 22dp; }
.match .nm { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; }
.match .v { font-family: Barlow Condensed; font-weight: 800; font-size: 13dp; color: #c0263f; margin: 0 7dp; }

/* right column */
.panel { display: flex; flex-direction: column; border: 1px #2a2830; background-color: rgba(20,19,23,214); }
#members-panel { flex: 1 1 0; }
#chat-panel { flex: 0 0 380dp; margin-top: 14dp; }
.phd { display: flex; align-items: center; padding: 10dp 16dp 6dp 16dp; border-bottom: 1px #2a2830; }
.search { margin: 10dp 16dp 6dp 16dp; padding: 7dp 12dp; border: 1px #2a2830; background-color: rgba(0,0,0,64); color: #6b6874; font-size: 14dp; }
.filters { display: flex; padding: 0 16dp 8dp 16dp; }
.f {
	font-family: Barlow Condensed; font-weight: 600; font-size: 12dp; letter-spacing: 1dp; text-transform: uppercase;
	padding: 3dp 9dp; margin-right: 6dp; border: 1px #3a3742; color: #9a97a3;
	tab-index: auto; nav: auto;
}
.f .c { color: #ecebf0; margin-left: 4dp; }
.f.on { background-color: #7e3bd6; border-color: #7e3bd6; color: #ffffff; }
.f:hover, .f:focus { border-color: #b08cf0; }
.hint { font-family: Barlow Condensed; font-weight: 600; font-size: 12dp; color: #6b6874; margin-left: auto; }

#members { flex: 1 1 0; overflow-y: auto; padding: 2dp 10dp 0 10dp; }
.grp { font-family: Barlow Condensed; font-weight: 700; font-size: 12dp; letter-spacing: 2.4dp; color: #6b6874; text-transform: uppercase; padding: 8dp 6dp 4dp 6dp; }
.m { display: flex; align-items: center; padding: 4dp 6dp; height: 42dp; box-sizing: border-box; }
.m:nth-child(even) { background-color: rgba(255,255,255,5); }
.m.me { border: 1px #7e3bd6; background-color: rgba(126,59,214,20); }
.m .a { width: 34dp; height: 34dp; border: 1px #3a3742; margin-right: 10dp; }
.m .n { font-family: Barlow Condensed; font-weight: 600; font-size: 17dp; flex: 1 1 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.m .n .c { color: #6b6874; font-weight: 500; font-size: 14dp; margin-left: 6dp; }
.m .n .crown { color: #e0415a; }
.st { font-family: Barlow Condensed; font-weight: 700; font-size: 11dp; letter-spacing: 1.1dp; text-transform: uppercase; padding: 2dp 7dp; margin-left: 8dp; }
.st.fight { color: #c0263f; background-color: rgba(244,63,94,26); }
.st.watch { color: #b08cf0; background-color: rgba(126,59,214,26); }
.st.queue { color: #e0415a; background-color: rgba(251,191,36,26); }
.st.idle { color: #4ade80; background-color: rgba(74,222,128,26); }
.st.afk { color: #6b6874; background-color: rgba(255,255,255,10); }
.m .p { font-family: Barlow Condensed; font-weight: 600; font-size: 12dp; color: #9a97a3; width: 48dp; text-align: right; }

scrollbarvertical { width: 6dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: rgba(255,255,255,8); }
scrollbarvertical sliderbar { background-color: #3a3742; }
scrollbarvertical sliderbar:hover { background-color: #7e3bd6; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }

.chat { display: flex; flex-direction: column; justify-content: flex-end; flex: 1 1 0; padding: 8dp 16dp; overflow: hidden; }
.msg { font-size: 15dp; line-height: 20dp; margin-top: 6dp; }
.msg .au { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; margin-right: 6dp; }
.msg.sys { color: #9a97a3; font-size: 14dp; }
.msg.sys .arrow { color: #b08cf0; margin-right: 4dp; }
.input { display: flex; justify-content: space-between; align-items: center; margin: 4dp 16dp 12dp 16dp; padding: 7dp 12dp; border: 1px #3a3742; background-color: rgba(0,0,0,64); color: #6b6874; }

/* bottom bar */
#bottom {
	display: flex; align-items: center; height: 72dp; flex: 0 0 72dp; padding: 0 18dp;
	border: 1px #2a2830; border-left: 4dp #7e3bd6;
	decorator: horizontal-gradient(rgba(126,59,214,34) rgba(20,19,23,214));
}
.me .lbl { font-family: Barlow Condensed; font-weight: 600; font-size: 11dp; letter-spacing: 2.4dp; color: #9a97a3; }
.me .who { font-family: Barlow Condensed; font-weight: 800; font-size: 22dp; }
.pick { display: flex; align-items: center; padding-left: 16dp; margin-left: 16dp; border-left: 1px #3a3742; }
.pick .face { width: 48dp; height: 48dp; margin-right: 10dp; }
.pick .c { font-family: Barlow Condensed; font-weight: 700; font-size: 17dp; }
.pick .c .s { display: block; color: #9a97a3; font-weight: 600; font-size: 12dp; letter-spacing: 1.2dp; }
.status { padding-left: 16dp; margin-left: 16dp; border-left: 1px #3a3742; }
.status .big { font-family: Barlow Condensed; font-weight: 800; font-size: 20dp; color: #e0415a; }
.status .s { font-family: Barlow Condensed; font-weight: 600; font-size: 13dp; color: #9a97a3; }
.hints { display: flex; align-items: center; margin-left: 16dp; font-family: Barlow Condensed; font-weight: 600; font-size: 14dp; color: #9a97a3; }
.hints .key { margin-left: 12dp; margin-right: 6dp; }

/* ---------- focus (pad / hitbox) ---------- */
.m { tab-index: auto; nav: auto; focus: auto; }
.m:focus { border: 1px #b08cf0; background-color: rgba(126,59,214,40); }
.m:hover { background-color: rgba(255,255,255,12); }
.f { focus: auto; }

.toast {
	position: absolute; left: 50%; bottom: 110dp; width: 640dp; margin-left: -320dp; box-sizing: border-box;
	padding: 12dp 18dp; text-align: center;
	font-family: Barlow Condensed; font-weight: 700; font-size: 19dp; letter-spacing: 0.6dp;
	border: 1px #7e3bd6; border-left: 4dp #7e3bd6; background-color: rgba(15,18,34,240); color: #ecebf0;
	z-index: 50;
}

.btn.dim { color: #6b6874; border-color: #2a2830; }

/* ---------- browser ---------- */
#browser-main { display: flex; flex: 1 1 0; margin-top: 14dp; margin-bottom: 14dp; }
#browser-list { display: flex; flex-direction: column; flex: 1 1 0; margin-right: 18dp; }
#browser-side { display: flex; flex-direction: column; flex: 0 0 440dp; }
.filterbar { display: flex; align-items: center; flex-wrap: wrap; margin-top: 10dp; }
.filterbar .lbl { font-family: Barlow Condensed; font-weight: 700; font-size: 13dp; letter-spacing: 1.6dp; color: #6b6874; text-transform: uppercase; margin-right: 8dp; }
.filterbar .gap { width: 22dp; }
.listhead { display: flex; padding: 12dp 18dp 6dp 18dp; font-family: Barlow Condensed; font-weight: 700; font-size: 12dp; letter-spacing: 1.8dp; color: #6b6874; text-transform: uppercase; }
#rows { flex: 1 1 0; overflow-y: auto; border: 1px #2a2830; background-color: rgba(20,19,23,214); padding: 4dp 8dp; }
.row {
	display: flex; align-items: center; height: 74dp; padding: 0 12dp; margin: 4dp 0; box-sizing: border-box;
	border: 1px #2a2830; background-color: rgba(255,255,255,6);
	tab-index: auto; nav: auto; focus: auto;
}
.row:hover { background-color: rgba(255,255,255,14); }
.row:focus { border: 2px #b08cf0; background-color: rgba(126,59,214,40); }
.row.full { opacity: 0.55; }
.row .c-name { flex: 1 1 0; }
.row .nm { font-family: Barlow Condensed; font-weight: 700; font-size: 22dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .sub { font-family: Barlow Condensed; font-weight: 600; font-size: 13dp; color: #9a97a3; letter-spacing: 0.6dp; }
.row .badge { font-family: Barlow Condensed; font-weight: 700; font-size: 11dp; letter-spacing: 1.2dp; padding: 1dp 6dp; margin-left: 8dp; background-color: #c0263f; color: #ffffff; }
.c-place { width: 190dp; font-family: Barlow Condensed; font-weight: 600; font-size: 16dp; color: #cfccd6; }
.c-tables { width: 110dp; font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; }
.c-people { width: 110dp; font-family: Barlow Condensed; font-weight: 700; font-size: 18dp; }
.c-ft { width: 60dp; font-family: Barlow Condensed; font-weight: 700; font-size: 15dp; color: #b08cf0; }
.c-ping { width: 90dp; text-align: right; font-family: Barlow Condensed; font-weight: 800; font-size: 20dp; }
.c-ping.good { color: #4ade80; }
.c-ping.fair { color: #e0415a; }
.c-ping.bad { color: #c0263f; }
.c-ping.unknown { color: #6b6874; }
.dots { display: flex; margin-top: 4dp; }
.dot { width: 10dp; height: 10dp; margin-right: 4dp; background-color: #7e3bd6; }
.emptylist { padding: 40dp; text-align: center; color: #9a97a3; font-family: Barlow Condensed; font-weight: 600; font-size: 18dp; }

.sidecard { border: 1px #2a2830; background-color: rgba(20,19,23,214); padding: 18dp; margin-bottom: 14dp; }
.sidecard .big { font-family: Barlow Condensed; font-weight: 800; font-size: 28dp; }
.sidecard .txt { font-size: 15dp; color: #9a97a3; line-height: 21dp; margin-top: 6dp; }
.sidecard .btn { margin: 14dp 0 0 0; display: block; text-align: center; }
.profile { display: flex; align-items: center; }
.profile .face { width: 72dp; height: 72dp; margin-right: 14dp; }

/* ---------- create ---------- */
#create-main { display: flex; flex: 1 1 0; margin-top: 14dp; margin-bottom: 14dp; }
#create-form { flex: 1 1 0; margin-right: 18dp; border: 1px #2a2830; background-color: rgba(20,19,23,214); padding: 22dp 26dp; }
#create-preview { flex: 0 0 520dp; }
.field { margin-bottom: 22dp; }
.field .lbl { font-family: Barlow Condensed; font-weight: 700; font-size: 14dp; letter-spacing: 2dp; color: #9a97a3; text-transform: uppercase; margin-bottom: 8dp; }
.field .hint { font-size: 13dp; color: #6b6874; margin-top: 6dp; }
.opts { display: flex; flex-wrap: wrap; }
.opt {
	font-family: Barlow Condensed; font-weight: 700; font-size: 20dp; text-align: center;
	min-width: 64dp; padding: 10dp 16dp; margin: 0 8dp 8dp 0; box-sizing: border-box;
	border: 1px #3a3742; background-color: rgba(255,255,255,8); color: #cfccd6;
	
	tab-index: auto; nav: auto; focus: auto;
}
.opt:hover { background-color: rgba(255,255,255,20); }
.opt:focus { border: 2px #b08cf0; }
.opt.on { decorator: horizontal-gradient(#7e3bd6 #6d28d9); border-color: #7e3bd6; color: #ffffff; }
input.text {
	display: block; width: 100%; box-sizing: border-box; padding: 10dp 12dp;
	font-family: Barlow Condensed; font-weight: 700; font-size: 22dp; color: #ecebf0;
	border: 1px #3a3742; background-color: rgba(0,0,0,80);
	tab-index: auto; nav: auto;
}
input.text:focus { border-color: #b08cf0; }
.mini-tables { display: flex; flex-wrap: wrap; margin-top: 14dp; }
.mini { width: 150dp; height: 90dp; margin: 0 10dp 10dp 0; border: 1px #3a3742; background-color: rgba(26,24,30,242); text-align: center; padding-top: 30dp; box-sizing: border-box; font-family: Barlow Condensed; font-weight: 700; font-size: 18dp; color: #9a97a3; }
.status-line { font-family: Barlow Condensed; font-weight: 700; font-size: 17dp; color: #e0415a; margin-top: 10dp; }

/* ---------- modals ---------- */
body.modal { decorator: none; background-color: rgba(6,6,8,190); }
.dialog {
	position: absolute; left: 50%; top: 50%; box-sizing: border-box;
	border: 1px #3a3742; border-top: 4dp #7e3bd6; background-color: rgba(20,19,23,250);
	padding: 24dp 28dp;
}
.dialog .title { font-family: Barlow Condensed; font-weight: 800; font-size: 30dp; letter-spacing: 1dp; }
.dialog .txt { font-size: 16dp; color: #9a97a3; margin-top: 4dp; }
.dialog .actions { display: flex; justify-content: flex-end; margin-top: 22dp; }
#picker { width: 1240dp; height: 760dp; margin-left: -620dp; margin-top: -380dp; }
.grid { display: flex; flex-wrap: wrap; margin-top: 16dp; }
.pick {
	width: 140dp; margin: 0 12dp 12dp 0; padding: 6dp; box-sizing: border-box; text-align: center;
	border: 1px #2a2830; background-color: rgba(255,255,255,6);
	tab-index: auto; nav: auto; focus: auto;
}
.pick img { width: 126dp; height: 126dp; }
.pick .nm { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; margin-top: 4dp; }
.pick:hover { background-color: rgba(255,255,255,16); }
.pick:focus { border: 2px #b08cf0; padding: 5dp; background-color: rgba(126,59,214,50); }
.pick.on { border: 2px #e0415a; padding: 5dp; }
#member, #challenge { width: 620dp; margin-left: -310dp; margin-top: -170dp; }
.who-card { display: flex; align-items: center; margin-top: 12dp; }
.who-card img { width: 110dp; height: 110dp; border: 2px #3a3742; margin-right: 18dp; }
.who-card .nm { font-family: Barlow Condensed; font-weight: 800; font-size: 32dp; }
.who-card .ch { font-family: Barlow Condensed; font-weight: 600; font-size: 15dp; letter-spacing: 1.4dp; color: #9a97a3; text-transform: uppercase; }

/* ---------- chat ---------- */
.quick { display: flex; flex-wrap: wrap; padding: 4dp 16dp 0 16dp; }
.qp {
	font-family: Barlow Condensed; font-weight: 700; font-size: 14dp; letter-spacing: 0.6dp;
	padding: 3dp 10dp; margin: 0 6dp 6dp 0; border: 1px #3a3742; background-color: rgba(255,255,255,8); color: #cfccd6;
	tab-index: auto; nav: auto; focus: auto;
}
.qp:hover { background-color: rgba(255,255,255,20); }
.qp:focus { border: 2px #b08cf0; color: #ffffff; }
.chatline { display: flex; align-items: center; padding: 2dp 16dp 12dp 16dp; }
.chatline .chatinput { flex: 1 1 0; width: auto; font-family: Barlow; font-weight: 500; font-size: 15dp; padding: 7dp 10dp; margin-right: 8dp; }
.chatline .btn { margin: 0; }

/* ---------- button glyphs (controller colours) ---------- */
.key { border: 1px rgba(255,255,255,40); font-family: Barlow Condensed; font-weight: 800; font-size: 13dp; }
.key.k-a { background-color: #22c55e; border-color: #4ade80; color: #052e14; }
.key.k-b { background-color: #ef4444; border-color: #f87171; color: #ffffff; }
.key.k-x { background-color: #3b82f6; border-color: #60a5fa; color: #ffffff; }
.key.k-y { background-color: #eab308; border-color: #facc15; color: #1f1600; }
.key.k-lb, .key.k-rb, .key.k-start, .key.k-back, .key.k-pill {
	border-radius: 5dp; min-width: 30dp; padding: 0 7dp;
	background-color: #3f4668; border-color: #6b6874; color: #ecebf0;
}
.key.k-kb { border-radius: 4dp; background-color: rgba(0,0,0,0); border-color: #9a97a3; color: #cfccd6; }
.btn .key { margin-left: 8dp; }

/* ---------- on-screen keyboard ---------- */
#keyboard { width: 1180dp; margin-left: -590dp; margin-top: -330dp; }
.kb-head { display: flex; align-items: baseline; justify-content: space-between; }
.kb-count { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; color: #6b6874; }
.kb-text {
	margin-top: 12dp; padding: 12dp 16dp; min-height: 56dp; box-sizing: border-box;
	border: 1px #7e3bd6; background-color: rgba(0,0,0,90);
	font-family: Barlow; font-weight: 500; font-size: 24dp; color: #ffffff; white-space: pre-wrap;
}
.caret { color: #b08cf0; animation: 1s linear-in-out infinite alternate blink; }
@keyframes blink { from { opacity: 1; } to { opacity: 0.1; } }
.kb-rows { margin-top: 16dp; }
.kb-row { display: flex; justify-content: center; margin-bottom: 8dp; }
.kc {
	width: 96dp; height: 58dp; line-height: 56dp; margin: 0 4dp; box-sizing: border-box; text-align: center;
	font-family: Barlow Condensed; font-weight: 700; font-size: 26dp; color: #ecebf0;
	border: 1px #3a3742; background-color: rgba(255,255,255,8);
	tab-index: auto; nav: auto; focus: auto;
}
.kc:hover { background-color: rgba(255,255,255,20); }
.kc:focus { border: 2px #b08cf0; background-color: rgba(126,59,214,70); color: #ffffff; }
.kc.wide { width: 210dp; font-size: 19dp; }
.kc.space { width: 330dp; font-size: 19dp; }
.kc.on { background-color: rgba(126,59,214,110); border-color: #b08cf0; }
.kc.ok { decorator: horizontal-gradient(#7e3bd6 #6d28d9); border-color: #7e3bd6; }
.kc .key { margin-left: 8dp; }
.kb-foot { margin-top: 12dp; font-family: Barlow Condensed; font-weight: 600; font-size: 15dp; color: #9a97a3; }
.kb-foot .key { margin: 0 5dp 0 14dp; }
.kbnote { color: #6b6874; margin-left: 12dp; }

.kbbtn { min-width: 44dp; text-align: center; padding: 6dp 10dp; margin: 0 8dp 0 0; }

/* ---------- character / colour select ---------- */
body.select { decorator: image(bg.png cover); background-color: #0a0a0c; }
#select { display: flex; flex-direction: column; height: 100%; padding: 18dp 26dp 14dp 26dp; box-sizing: border-box; }
#select-top { display: flex; align-items: center; height: 70dp; flex: 0 0 70dp; }
.steps { display: flex; }
.step { font-family: Barlow Condensed; font-weight: 800; font-size: 20dp; letter-spacing: 1.4dp; color: #6b6874; padding: 6dp 16dp; margin-left: 8dp; border-bottom: 3px #2a2830; text-transform: uppercase; }
.step.on { color: #ffffff; border-bottom-color: #7e3bd6; }
#select-main { display: flex; flex: 1 1 0; margin-top: 10dp; }
#select-hero {
	flex: 0 0 520dp; margin-right: 24dp; padding: 20dp; box-sizing: border-box; text-align: center;
	border: 1px #2a2830; decorator: vertical-gradient(rgba(92,22,42,140) rgba(13,16,36,230));
}
.hero { width: 400dp; height: 400dp; border: 2px #7e3bd6; }
.hero-name { font-family: Barlow Condensed; font-weight: 800; font-size: 54dp; letter-spacing: 2dp; text-transform: uppercase; margin-top: 12dp; }
.hero-colour { font-family: Barlow Condensed; font-weight: 700; font-size: 22dp; color: #b08cf0; letter-spacing: 1.6dp; text-transform: uppercase; }
.hero-swatches { margin-top: 12dp; }
.hero-swatches > div { display: flex; justify-content: center; }
.sw { width: 22dp; height: 22dp; margin: 0 2dp; border: 1px rgba(0,0,0,160); }
.sw.big { width: 56dp; height: 26dp; margin: 0 4dp; }
#select-grid, #select-colours { flex: 1 1 0; }
.sel-title { font-family: Barlow Condensed; font-weight: 800; font-size: 26dp; letter-spacing: 1.6dp; text-transform: uppercase; margin-bottom: 12dp; }
.sel-note { margin-top: 12dp; color: #6b6874; font-size: 14dp; }
.chars { display: flex; flex-wrap: wrap; }
.cell {
	width: 150dp; margin: 0 10dp 10dp 0; padding: 4dp; box-sizing: border-box; text-align: center;
	border: 1px #2a2830; background-color: rgba(20,19,23,228);
	tab-index: auto; nav: auto; focus: auto;
}
.cell img { width: 140dp; height: 140dp; }
.cell .nm { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; text-transform: uppercase; letter-spacing: 1dp; padding: 3dp 0; }
.cell:hover { background-color: rgba(255,255,255,16); }
.cell.on { border: 2px #e0415a; padding: 3dp; }
.cell:focus { border: 3px #b08cf0; padding: 2dp; background-color: rgba(126,59,214,70); }
.chips { display: flex; flex-wrap: wrap; }
.chip-c {
	width: 104dp; margin: 0 10dp 10dp 0; padding: 8dp 6dp 6dp 6dp; box-sizing: border-box; text-align: center;
	border: 1px #2a2830; background-color: rgba(20,19,23,228);
	tab-index: auto; nav: auto; focus: auto;
}
.chip-c .sws { display: flex; justify-content: center; }
.chip-c .lb { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; margin-top: 4dp; color: #cfccd6; }
.chip-c:hover { background-color: rgba(255,255,255,16); }
.chip-c.on { border: 2px #e0415a; padding: 7dp 5dp 5dp 5dp; }
.chip-c:focus { border: 3px #b08cf0; padding: 6dp 4dp 4dp 4dp; background-color: rgba(126,59,214,70); }
#select-bottom { display: flex; align-items: center; height: 56dp; flex: 0 0 56dp; }
#notice { width: 720dp; margin-left: -360dp; margin-top: -150dp; }

/* ---------- match starting ---------- */
body.starting { decorator: none; background-color: rgba(6,6,8,0); }
.mask-l, .mask-r { position: absolute; top: 0; bottom: 0; width: 50%; }
.mask-l { left: 0; decorator: horizontal-gradient(#120a10 #3a1670); animation: 0.45s cubic-out 1 mask-in-l; }
.mask-r { right: 0; decorator: horizontal-gradient(#6e1528 #120a10); animation: 0.45s cubic-out 1 mask-in-r; }
@keyframes mask-in-l { from { transform: translateX(-100%); } to { transform: translateX(0%); } }
@keyframes mask-in-r { from { transform: translateX(100%); } to { transform: translateX(0%); } }
#start-card {
	position: absolute; left: 50%; top: 50%; width: 1100dp; margin-left: -550dp; margin-top: -300dp; height: 600dp;
	text-align: center; animation: 0.35s 0.25s cubic-out 1 card-in;
}
@keyframes card-in { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
.st-head { font-family: Barlow Condensed; font-weight: 800; font-size: 26dp; letter-spacing: 6dp; color: #e0415a; }
.st-vs { display: flex; align-items: center; justify-content: center; margin-top: 26dp; }
.st-side { width: 380dp; }
.st-face { width: 260dp; height: 260dp; border: 3px #ffffff; }
.st-name { font-family: Barlow Condensed; font-weight: 800; font-size: 40dp; margin-top: 12dp; }
.st-char { font-family: Barlow Condensed; font-weight: 700; font-size: 18dp; letter-spacing: 3dp; color: #cfccd6; text-transform: uppercase; }
.st-mid { width: 200dp; font-family: Barlow Condensed; font-weight: 800; font-size: 110dp; color: #ffffff; animation: 0.9s cubic-in-out infinite alternate vs-pulse; }
@keyframes vs-pulse { from { transform: scale(1); color: #ffffff; } to { transform: scale(1.12); color: #e0415a; } }
.st-load { display: flex; align-items: center; justify-content: center; margin-top: 34dp; }
.spinner { position: relative; width: 34dp; height: 34dp; margin-right: 16dp; animation: 1s linear infinite spin; }
.spinner .d { position: absolute; width: 6dp; height: 6dp; border-radius: 3dp; background-color: #e0415a; }
.spinner .d0 { left: 27dp; top: 14dp; opacity: 1; }
.spinner .d1 { left: 23.2dp; top: 23.2dp; opacity: 0.88; }
.spinner .d2 { left: 14dp; top: 27dp; opacity: 0.76; }
.spinner .d3 { left: 4.8dp; top: 23.2dp; opacity: 0.64; }
.spinner .d4 { left: 1dp; top: 14dp; opacity: 0.52; }
.spinner .d5 { left: 4.8dp; top: 4.8dp; opacity: 0.4; }
.spinner .d6 { left: 14dp; top: 1dp; opacity: 0.28; }
.spinner .d7 { left: 23.2dp; top: 4.8dp; opacity: 0.16; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.st-text { font-family: Barlow Condensed; font-weight: 700; font-size: 24dp; letter-spacing: 1.5dp; }
.st-bar { width: 520dp; height: 6dp; margin: 18dp auto 0 auto; background-color: rgba(255,255,255,30); }
.st-fill { height: 6dp; width: 0%; decorator: horizontal-gradient(#7e3bd6 #e0415a); animation: 3s linear 1 fill; }
@keyframes fill { from { width: 0%; } to { width: 100%; } }

/* ---------- glyph styles: PlayStation and flat (A B C D) ---------- */
.ps .key.k-a, .ps .key.k-b, .ps .key.k-x, .ps .key.k-y { background-color: #1c1b20; font-family: Barlow; font-weight: 700; font-size: 14dp; }
.ps .key.k-a { color: #6aa5ff; border-color: #6aa5ff; }
.ps .key.k-b { color: #ff6b6b; border-color: #ff6b6b; }
.ps .key.k-x { color: #f08bd8; border-color: #f08bd8; }
.ps .key.k-y { color: #4fd1a5; border-color: #4fd1a5; }
.ps .key.k-lb, .ps .key.k-rb, .ps .key.k-start, .ps .key.k-back { background-color: #1c1b20; border-color: #6b6874; color: #ecebf0; }
.flat .key, .flat .key.k-a, .flat .key.k-b, .flat .key.k-x, .flat .key.k-y,
.flat .key.k-lb, .flat .key.k-rb, .flat .key.k-start, .flat .key.k-back {
	background-color: #ecebf0; border-color: #ecebf0; color: #0e0e11; border-radius: 4dp;
}

/* ---------- settings ---------- */
.gear { min-width: 44dp; text-align: center; font-size: 20dp; padding: 6dp 12dp; }
#settings { width: 760dp; margin-left: -380dp; margin-top: -230dp; }
.styles { display: flex; margin-top: 16dp; }
.style-card {
	flex: 1 1 0; margin-right: 12dp; padding: 14dp; box-sizing: border-box; text-align: center;
	border: 1px #3a3742; background-color: rgba(255,255,255,6);
	tab-index: auto; nav: auto; focus: auto;
}
.style-card:hover { background-color: rgba(255,255,255,16); }
.style-card:focus { border: 2px #b08cf0; padding: 13dp; }
.style-card.on { border: 2px #e0415a; padding: 13dp; }
.style-card .nm { font-family: Barlow Condensed; font-weight: 800; font-size: 22dp; margin-bottom: 10dp; }
.style-card .row { display: flex; justify-content: center; }
.style-card .key { margin: 0 3dp; }
.style-card .ps-a { background-color: #1c1b20; color: #6aa5ff; border-color: #6aa5ff; }
.style-card .ps-b { background-color: #1c1b20; color: #ff6b6b; border-color: #ff6b6b; }
.style-card .ps-x { background-color: #1c1b20; color: #f08bd8; border-color: #f08bd8; }
.style-card .ps-y { background-color: #1c1b20; color: #4fd1a5; border-color: #4fd1a5; }
.style-card .flat-k { background-color: #ecebf0; border-color: #ecebf0; color: #0e0e11; border-radius: 4dp; }

/* ---------- score screen after each table game ---------- */
body.postgame { decorator: none; background-color: rgba(6,6,8,215); }
#post-card { position: absolute; left: 50%; top: 50%; width: 1100dp; margin-left: -550dp; margin-top: -320dp; text-align: center;
	animation: 0.3s cubic-out 1 card-in; }
.pg-head { font-family: Barlow Condensed; font-weight: 800; font-size: 26dp; letter-spacing: 5dp; color: #e0415a; }
.pg-vs { display: flex; align-items: center; justify-content: center; margin-top: 22dp; }
.pg-side { width: 340dp; }
.pg-face { width: 220dp; height: 220dp; border: 3px #ffffff; }
.pg-name { font-family: Barlow Condensed; font-weight: 800; font-size: 36dp; margin-top: 10dp; }
.pg-char { font-family: Barlow Condensed; font-weight: 700; font-size: 16dp; letter-spacing: 3dp; color: #cfccd6; text-transform: uppercase; }
.pg-score { width: 300dp; font-family: Barlow Condensed; font-weight: 800; font-size: 120dp; color: #ffffff; }
.pg-dash { color: #6b6874; margin: 0 14dp; }
.pg-actions { display: flex; justify-content: center; margin-top: 30dp; }
.pg-btn { font-size: 24dp; padding: 14dp 34dp; margin: 0 12dp; }
.pg-status { margin-top: 20dp; font-family: Barlow Condensed; font-weight: 700; font-size: 20dp; color: #cfccd6; }
.pg-note { margin-top: 6dp; font-size: 15dp; color: #9a97a3; }

/* ---------- button glyphs: vertically centred in text, PlayStation in bold ---------- */
.key { vertical-align: middle; line-height: 20dp; height: 22dp; box-sizing: border-box; }
.ps .key.k-a, .ps .key.k-b, .ps .key.k-x, .ps .key.k-y { font-weight: 800; font-size: 13dp; line-height: 19dp; }
.style-card .ps-a, .style-card .ps-b, .style-card .ps-x, .style-card .ps-y { font-weight: 800; font-size: 13dp; line-height: 19dp; }

/* ---------- back to the lobby after a set (covers the game's menu hops) ---------- */
body.returning { background-color: #0a0a0c; decorator: image(bg.png cover); }
#return-card { position: absolute; left: 0; right: 0; top: 40%; text-align: center; }
.rt-title { font-family: Barlow Condensed; font-weight: 800; font-size: 54dp; margin-top: 14dp; }
.rt-fill { height: 6dp; width: 0%; decorator: horizontal-gradient(#7e3bd6 #e0415a); animation: 8s cubic-out 1 fill; }

/* ---------- in-match spectator badge (players and viewers) ---------- */
body.hud { decorator: none; background-color: rgba(0,0,0,0); pointer-events: none; }
#watch-badge {
	position: absolute; left: 0; bottom: 0; height: 30dp; padding: 0 12dp 0 10dp;
	display: flex; align-items: center;
	background-color: #7c3aed;
}
.wb-icon { position: relative; width: 18dp; height: 22dp; margin-right: 8dp; }
.wb-head { position: absolute; left: 5dp; top: 1dp; width: 8dp; height: 8dp; border-radius: 4dp; background-color: #ffffff; }
.wb-body { position: absolute; left: 1dp; top: 11dp; width: 16dp; height: 10dp; border-radius: 8dp 8dp 2dp 2dp; background-color: #ffffff; }
.wb-count { font-family: Barlow Condensed; font-weight: 800; font-size: 22dp; color: #ffffff; margin-right: 6dp; }

/* ---------- settings previews keep their own colours whatever style is chosen ---------- */
.style-card .key.xb-a { background-color: #22c55e; border-color: #4ade80; color: #052e14; }
.style-card .key.xb-b { background-color: #ef4444; border-color: #f87171; color: #ffffff; }
.style-card .key.xb-x { background-color: #3b82f6; border-color: #60a5fa; color: #ffffff; }
.style-card .key.xb-y { background-color: #eab308; border-color: #facc15; color: #1f1600; }

/* ---------- spectator screen (between games / syncing to live) ---------- */
#watch-card { position: absolute; left: 50%; top: 50%; width: 1100dp; margin-left: -550dp; margin-top: -280dp; text-align: center; }
#watch-card .pg-note { margin-top: 26dp; }

/* the round Xbox / PlayStation previews stay round whatever style is chosen */
.style-card .key.xb-a, .style-card .key.xb-b, .style-card .key.xb-x, .style-card .key.xb-y,
.style-card .key.ps-a, .style-card .key.ps-b, .style-card .key.ps-x, .style-card .key.ps-y { border-radius: 11dp; }

/* ---------- chat over the watched match (Right + Start) ---------- */
body.wchat-body { decorator: none; background-color: rgba(0,0,0,0); }
#wchat {
	position: absolute; right: 0; top: 12%; bottom: 12%; width: 420dp; padding: 14dp 16dp;
	background-color: rgba(14,13,17,180); border-left: 3dp #7c3aed;
	display: flex; flex-direction: column;
	opacity: 0; transform: translateX(100%);
	transition: opacity transform 0.3s cubic-out;
}
#wchat.on { opacity: 1; transform: translateX(0%); }
.wchat-head { font-family: Barlow Condensed; font-weight: 800; font-size: 18dp; letter-spacing: 3dp; color: #cdb8f5; }
.wchat-list { flex: 1 1 0; overflow: hidden; margin-top: 8dp; display: flex; flex-direction: column; justify-content: flex-end; }
.wchat-list .msg { font-size: 16dp; line-height: 22dp; color: #ecebf0; margin-top: 4dp; }
.wchat-foot { margin-top: 8dp; font-size: 13dp; color: #a5a8c8; }
.badge.lock { background-color: #7c3aed; color: #ffffff; }

/* ---------- IM custom palettes in the colour step ---------- */
.custom-title { margin-top: 18dp; }
.chip-c.custom { width: auto; min-width: 150dp; padding: 0 12dp; }
.chip-c.custom .lb { font-size: 15dp; }

/* ---------- turn, rotation, pinned message ---------- */
.shint { font-size: 13dp; color: #6b6874; margin-top: 6dp; }
.card .hd .tag.streak { margin-left: 8dp; color: #e0415a; border-color: rgba(224,65,90,102); }
.card .hd .tag.tour { margin-left: 8dp; color: #b08cf0; }
.detail.auto { color: #e0415a; font-weight: 700; }
.pinned {
	margin: 6dp 0 2dp 0; padding: 6dp 10dp; font-size: 14dp; line-height: 19dp; color: #ecebf0;
	background-color: rgba(126,59,214,40); border-left: 3dp #7e3bd6;
}
.pinned .pin-lbl { font-family: Barlow Condensed; font-weight: 800; font-size: 12dp; letter-spacing: 2dp; color: #b08cf0; margin-right: 8dp; }
#top .btn .dot { display: inline-block; width: 8dp; height: 8dp; border-radius: 4dp; margin-left: 8dp; background-color: #e0415a; }

/* ---------- member card: profile and moderation ---------- */
.minfo { font-size: 14dp; color: #cfccd6; margin-top: 4dp; }
.minfo .bad { color: #e0415a; font-weight: 700; }
.minfo .mrec { font-size: 12dp; color: #6b6874; margin-left: 6dp; }
.warn { margin-top: 12dp; padding: 8dp 10dp; font-size: 14dp; color: #ecebf0; background-color: rgba(192,38,63,60); border-left: 3dp #c0263f; }
.modrow { display: flex; margin-top: 14dp; padding-top: 12dp; border-top: 1px #2a2830; }
.modrow .btn { margin-right: 8dp; }

/* ---------- history ---------- */
#history { width: 820dp; margin-left: -410dp; margin-top: -300dp; }
.hist-list { margin-top: 12dp; max-height: 460dp; overflow-y: auto; }
.hist-row { display: flex; align-items: center; padding: 7dp 10dp; border-bottom: 1px #2a2830; font-size: 15dp; }
.hist-row.mine { background-color: rgba(126,59,214,26); }
.hist-time { width: 56dp; color: #6b6874; font-size: 13dp; }
.hist-table { width: 70dp; color: #9a97a3; font-size: 13dp; }
.hist-name { flex: 1 1 0; color: #ecebf0; }
.hist-name.r { text-align: right; }
.hist-score { width: 80dp; text-align: center; font-family: Barlow Condensed; font-weight: 800; font-size: 18dp; color: #cfccd6; }
.hist-note { margin-left: 10dp; font-size: 12dp; color: #b08cf0; }

/* ---------- tournament ---------- */
#tournament { width: 1160dp; margin-left: -580dp; margin-top: -340dp; }
.tour-tag { font-size: 13dp; letter-spacing: 2dp; color: #b08cf0; margin-left: 12dp; }
.tour-tag.live { color: #e0415a; }
.tour-count { font-family: Barlow Condensed; font-weight: 800; font-size: 26dp; margin-top: 10dp; color: #ecebf0; }
.tour-champ { margin-top: 12dp; padding: 10dp 14dp; font-family: Barlow Condensed; font-weight: 800; font-size: 24dp; letter-spacing: 1dp;
	color: #ffffff; decorator: horizontal-gradient(#6e1528 #3a1670); }
.bracket { display: flex; margin-top: 14dp; max-height: 470dp; overflow-y: auto; }
.tour-round { flex: 1 1 0; margin-right: 12dp; }
.tour-round-name { font-family: Barlow Condensed; font-weight: 800; font-size: 15dp; letter-spacing: 2dp; color: #9a97a3; margin-bottom: 8dp; text-transform: uppercase; }
.tour-match { margin-bottom: 10dp; border: 1px #2a2830; background-color: rgba(20,19,23,228); }
.tour-match.mine { border-color: #7e3bd6; }
.tour-match.bye { opacity: 0.6; }
.tour-player { padding: 5dp 8dp; font-size: 14dp; color: #cfccd6; }
.tour-player.won { color: #ffffff; font-weight: 700; background-color: rgba(126,59,214,40); }
.tour-player.lost { color: #6b6874; }
.tour-table { padding: 3dp 8dp; font-size: 12dp; color: #e0415a; border-top: 1px #2a2830; }

/* ---------- reactions in the watch chat ---------- */
.wchat-react { display: flex; flex-wrap: wrap; margin-top: 8dp; }
.wchat-react .rc { padding: 3dp 8dp; margin: 0 6dp 6dp 0; font-size: 13dp; color: #cfccd6; border: 1px #3a3742; }
.wchat-react .rc.on { color: #ffffff; border-color: #e0415a; background-color: rgba(224,65,90,60); }
