<rml>
<head>
	<title>Great Lobby - aviso</title>
	<link type="text/rcss" href="lobby.rcss"/>
</head>
<body class="modal" data-model="gl" data-class-ps="glyphs == 'ps'" data-class-flat="glyphs == 'flat'">
	<div class="dialog" id="notice">
		<div class="title">{{notice_title}}</div>
		<div class="txt" style="margin-top: 10dp; font-size: 18dp; line-height: 25dp; color: #cfccd6;">{{notice_text}}</div>
		<div class="actions">
			<div class="btn pri" autofocus="" data-event-click="notice_ok()">OK<span class="key k-a">{{g_a}}</span></div>
		</div>
	</div>
</body>
</rml>
