<rml>
<head>
	<title>Great Lobby - placar</title>
	<link type="text/rcss" href="lobby.rcss"/>
</head>
<body class="postgame" data-model="gl" data-class-ps="glyphs == 'ps'" data-class-flat="glyphs == 'flat'">
	<div id="post-card">
		<div class="pg-head">
			<span data-if="!post_set_done">FIM DO JOGO {{post_game}} · PRIMEIRO A {{post_ft}}</span>
			<span data-if="post_set_done">SÉRIE DECIDIDA · PRIMEIRO A {{post_ft}}</span>
		</div>
		<div class="pg-vs">
			<div class="pg-side">
				<img class="pg-face" data-attr-src="post_a.face"/>
				<div class="pg-name">{{post_a.name}}</div>
				<div class="pg-char">{{post_a.character}}</div>
			</div>
			<div class="pg-score">{{post_score_a}}<span class="pg-dash">–</span>{{post_score_b}}</div>
			<div class="pg-side">
				<img class="pg-face" data-attr-src="post_b.face"/>
				<div class="pg-name">{{post_b.name}}</div>
				<div class="pg-char">{{post_b.character}}</div>
			</div>
		</div>

		<div class="pg-actions" data-if="!post_set_done">
			<div class="btn pri pg-btn" autofocus="" data-event-click="rematch(1)">Revanche<span class="key k-a">{{g_a}}</span></div>
			<div class="btn pg-btn" data-event-click="rematch(0)">Voltar ao lobby<span class="key k-b">{{g_b}}</span></div>
		</div>
		<div class="pg-status" data-if="!post_set_done">Você: {{post_mine}} · Oponente: {{post_theirs}} · {{post_seconds}} s</div>
		<div class="pg-note" data-if="!post_set_done">Os dois precisam confirmar a revanche em 30 s. Se o tempo acabar, todos voltam ao lobby.</div>
		<div class="pg-status" data-if="post_set_done">Salvando o replay · voltando ao lobby em {{post_seconds}} s</div>
		<div class="pg-note" data-if="post_set_done">{{g_b}} volta agora.</div>
	</div>
</body>
</rml>
