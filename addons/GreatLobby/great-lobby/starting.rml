<rml>
<head>
	<title>Great Lobby - partida começando</title>
	<link type="text/rcss" href="lobby.rcss"/>
</head>
<body class="starting" data-model="gl" data-class-ps="glyphs == 'ps'" data-class-flat="glyphs == 'flat'">
	<div class="mask-l"></div>
	<div class="mask-r"></div>

	<div id="start-card">
		<div class="st-head">MESA {{starting_table}} · PARTIDA COMEÇANDO</div>
		<div class="st-vs">
			<div class="st-side">
				<img class="st-face" data-attr-src="starting_a.face"/>
				<div class="st-name">{{starting_a.name}}</div>
				<div class="st-char">{{starting_a.character}}</div>
			</div>
			<div class="st-mid">VS</div>
			<div class="st-side">
				<img class="st-face" data-attr-src="starting_b.face"/>
				<div class="st-name">{{starting_b.name}}</div>
				<div class="st-char">{{starting_b.character}}</div>
			</div>
		</div>
		<div class="st-load">
			<div class="spinner"><div class="d d0"></div><div class="d d1"></div><div class="d d2"></div><div class="d d3"></div><div class="d d4"></div><div class="d d5"></div><div class="d d6"></div><div class="d d7"></div></div>
			<div class="st-text" data-if="starting_count &gt; 0">Conectando os dois jogadores · {{starting_count}}</div>
			<div class="st-text" data-if="starting_count == 0">Carregando a luta…</div>
		</div>
		<div class="st-bar"><div class="st-fill"></div></div>
	</div>
</body>
</rml>
