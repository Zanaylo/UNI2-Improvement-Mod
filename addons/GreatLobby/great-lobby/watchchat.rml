<rml>
<head>
	<title>Great Lobby - chat ao assistir</title>
	<link type="text/rcss" href="lobby.rcss"/>
</head>
<body class="wchat-body" data-model="gl" data-class-ps="glyphs == 'ps'" data-class-flat="glyphs == 'flat'">
	<div id="wchat" data-class-on="watch_chat">
		<div class="wchat-head">CHAT DO LOBBY</div>
		<div class="wchat-list">
			<div class="msg" data-for="line : chat" data-class-sys="line.kind == 'sys'">
				<span class="arrow" data-if="line.kind == 'sys'">▸</span>
				<span class="au" data-if="line.kind != 'sys'" data-style-color="line.colour">{{line.author}}</span>{{line.text}}
			</div>
		</div>
		<div class="wchat-react">
			<span class="rc" data-for="q, i : quick_phrases" data-class-on="i == reaction">{{q.label}}</span>
		</div>
		<div class="wchat-foot"><span class="key k-lb">{{g_lb}}</span><span class="key k-rb" style="margin-left: 0;">{{g_rb}}</span> escolhe · <span class="key k-x">{{g_x}}</span> manda a reação</div>
		<div class="wchat-foot"><span class="key k-a">{{g_a}}</span> ou Enter escreve · <span class="key k-lb">→</span> + <span class="key k-start">{{g_start}}</span> fecha</div>
	</div>
</body>
</rml>
